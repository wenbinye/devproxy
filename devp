#!/usr/bin/env python3
"""devp — 本地开发动态域名网关（*.test → 127.0.0.1:动态端口）

用法:
  devp up <name> [--port N] [--ready-timeout S] -- CMD...
  devp down <name>
  devp ls
  devp selftest

注册协议与设计决策见 docs/superpowers/specs/2026-10-21-devp-dynamic-domain-gateway-design.md
"""
import argparse
import fcntl
import json
import math
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from contextlib import contextmanager

ADMIN_BASE = os.environ.get("DEVP_ADMIN", "http://127.0.0.1:2019")
ROUTES_PATH = "/config/apps/http/servers/srv0/routes"
LOCK_PATH = os.environ.get("DEVP_LOCK", os.path.expanduser("~/.local/state/devp/lock"))

_HEARTBEAT_RAW = os.environ.get("DEVP_HEARTBEAT", "30")
try:
    _HEARTBEAT_VALUE = float(_HEARTBEAT_RAW)
except ValueError:
    _HEARTBEAT_VALUE = None
if _HEARTBEAT_VALUE is None or not math.isfinite(_HEARTBEAT_VALUE) or _HEARTBEAT_VALUE <= 0:
    # 模块级常量不能让整个 CLI 起不来：非法值回落默认值并告警。
    # nan/inf 能通过 float()，必须再校验有限性与正数，否则 stop.wait(nan) 等会行为异常。
    print(
        f"devp: 警告: DEVP_HEARTBEAT={_HEARTBEAT_RAW!r} 不是有限正数，回落到 30.0",
        file=sys.stderr,
    )
    HEARTBEAT = 30.0
else:
    HEARTBEAT = _HEARTBEAT_VALUE

# 用 \A / \Z 而非 ^ / $ —— $ 也会匹配末尾换行之前，"codeup\n" 会被误放行
NAME_RE = re.compile(r"\A[a-z0-9][a-z0-9-]*\Z")


def validate_name(name):
    """非法 name 直接退出：单标签限制来自 NAME_RE（首字符 [a-z0-9]、后续 [a-z0-9-]、≤63）。"""
    if not NAME_RE.match(name) or len(name) > 63:
        sys.exit(f"devp: 非法 name {name!r}: 限单标签 [a-z0-9-]（不得含点）")


def alloc_port():
    """绑定 :0 取一个随机空闲端口后立即释放。存在微小时隙竞争，
    子进程 bind 失败时会以子进程自身错误呈现，重跑即可。"""
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def api(method, path, body=None, base=None):
    """调用 Caddy Admin API。HTTP 错误返回 (code, None)，连接失败返回 (0, None)。"""
    url = (base or ADMIN_BASE).rstrip("/") + path
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json"} if data else {}
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            raw = r.read()
            return r.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as e:
        return e.code, None
    except (urllib.error.URLError, OSError):
        return 0, None


@contextmanager
def locked(path=None):
    """flock 互斥，包住 GET+PATCH 读改写临界区。"""
    path = path or LOCK_PATH
    d = os.path.dirname(path)
    if d:  # 相对路径（如 "devp.lock"）dirname 为空，makedirs("") 会抛 FileNotFoundError
        os.makedirs(d, exist_ok=True)
    fh = open(path, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield
    finally:
        fh.close()


def build_route(name, port):
    validate_name(name)
    return {
        "@id": f"devp_{name}",
        "match": [{"host": [f"{name}.test"]}],
        "handle": [{"handler": "reverse_proxy",
                    "upstreams": [{"dial": f"127.0.0.1:{port}"}]}],
        "terminal": True,
    }


def is_wildcard(route):
    return any("*" in h for m in route.get("match", []) for h in m.get("host", []))


def insert_route(routes, route):
    """插到首个通配 host 路由之前（POST 追加会被 *.test 兜底遮蔽，实测结论）。"""
    idx = next((i for i, r in enumerate(routes) if is_wildcard(r)), len(routes))
    routes.insert(idx, route)
    return routes


def register(name, port, base=None, stop=None):
    """GET 路由数组 → 同名路由就地替换，否则插到通配路由之前 → PATCH 回写。flock 防并发。

    PATCH 成功后回读 /id/<name> 确认生效（替代 srv0 动态发现：写入丢失时不能误报成功）。
    stop 置位后不再写回：持锁后再检查一次，避免心跳在注销之后把路由补回来。
    """
    validate_name(name)
    with locked():
        if stop is not None and stop.is_set():
            return False
        st, routes = api("GET", ROUTES_PATH, base=base)
        if st != 200:
            return False
        if not isinstance(routes, list):
            # Caddy 返回 200+null 时不能把整个 routes 数组覆盖成空
            return False
        route = build_route(name, port)
        rid = route["@id"]
        for i, r in enumerate(routes):
            if r.get("@id") == rid:
                # 幂等：PATCH 已生效但响应丢失后重试会再看到自己，必须就地替换而不是再插一个
                routes[i] = route
                break
        else:
            insert_route(routes, route)
        st, _ = api("PATCH", ROUTES_PATH, body=routes, base=base)
        return st == 200 and route_exists(name, base=base)


def deregister(name, base=None):
    """DELETE /id/devp_<name>。与 register 共用同一把 flock，避免跨进程注销/写回交错。"""
    validate_name(name)
    with locked():
        st, _ = api("DELETE", f"/id/devp_{name}", base=base)
    return st == 200


def deregister_retry(name, base=None, attempts=3):
    """注销重试：默认 3 次尝试，失败间隔 1s、2s；每次重试重新加锁，不跨重试持锁。"""
    for i in range(attempts):
        if deregister(name, base=base):
            return True
        if i < attempts - 1:
            time.sleep(2 ** i)
    return False


def route_exists(name, base=None):
    validate_name(name)
    st, _ = api("GET", f"/id/devp_{name}", base=base)
    return st == 200


def register_retry(name, port, base=None, attempts=3, stop=None):
    """注册重试：默认 3 次尝试，失败间隔 1s、2s；stop 置位后不再发起新尝试。"""
    for i in range(attempts):
        if stop is not None and stop.is_set():
            return False
        if register(name, port, base=base, stop=stop):
            return True
        if i < attempts - 1:
            time.sleep(2 ** i)
    return False


def list_routes(base=None):
    st, routes = api("GET", ROUTES_PATH, base=base)
    out = []
    for r in routes or []:
        rid = r.get("@id", "")
        if not rid.startswith("devp_"):
            continue
        name = rid[len("devp_"):]
        host = r["match"][0]["host"][0]
        dial = r["handle"][0]["upstreams"][0]["dial"]
        out.append((name, host, dial, int(dial.rsplit(":", 1)[1])))
    return out


def reachable(port, timeout=0.5):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except OSError:
        return False


def _stop(proc, pgid=None, sig=signal.SIGTERM):
    """向子进程组发信号 → 有限等待 → SIGKILL 进程组，确保孙进程也不残留。

    子进程以 start_new_session=True 启动，pgid == pid；npm run dev 之类的多级
    launcher 会再 fork 孙进程，只杀直接子进程会让孙进程继续占着端口。
    pgid 在启动时捕获：组长（直接子进程）先退出时（如 launcher 场景），进程组
    里仍留着孙进程，依然要按组发信号——不能因为 proc.poll() 已非 None 就跳过。
    """
    if proc is None:
        return
    if pgid is None:
        try:
            pgid = os.getpgid(proc.pid)
        except ProcessLookupError:
            pgid = proc.pid
    try:
        os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    # 组长可能已退出但组内仍有孙进程：再按组补一刀 SIGKILL
    try:
        os.killpg(pgid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def cmd_up(a):
    validate_name(a.name)
    if a.port is not None and not (1 <= a.port <= 65535):
        sys.exit(f"devp: 非法端口 {a.port}：--port 必须在 1..65535 之间")
    st, _ = api("GET", "/config/")
    if st != 200:
        sys.exit("devp: Caddy Admin API 不可达（caddy 是否在运行？）")
    if route_exists(a.name):
        sys.exit(f"devp: {a.name} 已注册，先 devp down {a.name} 或换名")
    port = a.port or alloc_port()
    env = dict(os.environ, PORT=str(port))
    registered = False
    registering = False  # 已开始注册：可能已经写进 Caddy，退出时也要尝试注销
    stop = threading.Event()
    hb = None
    hb_started = False
    proc = None
    pgid = None

    def on_signal(signum, frame):
        # 清理期间收到第二个信号时直接忽略，避免中断 finally 留下残留；
        # 首个信号统一走 finally 路径，退出码由 SystemExit(128+signum) 决定。
        if stop.is_set():
            return
        stop.set()
        if pgid is not None:
            # 按组转发：组长可能已退出但组内仍有孙进程
            child_sig = signal.SIGINT if signum == signal.SIGINT else signal.SIGTERM
            try:
                os.killpg(pgid, child_sig)
            except (ProcessLookupError, PermissionError):
                pass
        raise SystemExit(128 + signum)

    old_handlers = {
        s: signal.signal(s, on_signal) for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    }

    print(f"PORT={port} 已分配，启动: {' '.join(a.cmd)}")
    try:
        try:
            # 独立 session/进程组：devp 显式转发信号，退出时可按组清理孙进程
            proc = subprocess.Popen(a.cmd, env=env, start_new_session=True)
            pgid = proc.pid  # start_new_session=True → 子进程是进程组 leader
        except FileNotFoundError:
            sys.exit(f"devp: 命令不存在: {a.cmd[0]}")
        print(f"等待 127.0.0.1:{port} 就绪（超时 {a.ready_timeout}s）…")
        deadline = time.time() + a.ready_timeout
        while time.time() < deadline:
            if proc.poll() is not None:
                sys.exit(f"devp: 子进程先退出（code={proc.returncode}），未注册")
            if reachable(port, timeout=1):
                break
            time.sleep(0.3)
        else:
            sys.exit("devp: 就绪超时——应用可能未使用 $PORT，可用 --port 显式指定")
        registering = True
        if not register_retry(a.name, port):
            sys.exit("devp: 注册失败（Admin API PATCH 重试 3 次未成功）")
        registered = True
        print(f"✅ https://{a.name}.test")
        hb = threading.Thread(target=heartbeat, args=(a.name, port, stop), daemon=True)
        hb.start()
        hb_started = True
        rc = proc.wait()
    finally:
        stop.set()
        if hb_started:
            # 有界 join：等心跳体内可能正在进行的 register_retry 结束；stop 置位后
            # 心跳不会再发起新尝试，持锁后的二次检查也不会写回。
            hb.join(timeout=10)
        if registered or registering:
            # registering 为真但注册未确认时，DELETE 404 属正常：只有路由仍在才告警
            if not deregister_retry(a.name) and route_exists(a.name):
                print(f"⚠️ devp: 注销失败，残留路由请执行 devp down {a.name}", file=sys.stderr)
        _stop(proc, pgid)
        for s, handler in old_handlers.items():
            signal.signal(s, handler)
    # 被信号杀死时 wait() 返回 -n；映射成 shell 约定的 128+n（SIGINT→130, SIGTERM→143）
    rc = 128 - rc if rc < 0 else rc
    sys.exit(rc)


def heartbeat(name, port, stop, interval=None):
    """每 interval 校验路由存在，丢失（caddy reload/重启）则重注册。"""
    interval = interval or HEARTBEAT
    while not stop.wait(interval):
        try:
            if stop.is_set():
                return
            if not route_exists(name) and not register_retry(name, port, stop=stop):
                print(f"⚠️ devp: 心跳重注册失败（https://{name}.test），"
                      f"将按 {interval}s 间隔重试", file=sys.stderr)
        except Exception:
            # Admin 返回畸形响应等异常不能杀死心跳线程，否则此后不再重注册
            pass


def cmd_down(a):
    validate_name(a.name)
    # 与 cmd_ls 的 D19 口径一致：先区分「Admin 不可达」与「确实没有该路由」
    st, _ = api("GET", "/config/")
    if st != 200:
        sys.exit("devp: Caddy Admin API 不可达")
    # 未注册的 name 直接报错，不必白等注销重试的 ~3s
    if not route_exists(a.name):
        sys.exit(f"devp: {a.name} 未注册")
    if deregister_retry(a.name):
        print(f"已注销 {a.name}.test")
    else:
        sys.exit(f"devp: {a.name} 未注册（或注销失败）")


def cmd_ls(a):
    # 先区分「Admin 不可达」与「确实没有路由」，避免把故障误报成空状态
    st, _ = api("GET", ROUTES_PATH)
    if st != 200:
        sys.exit("devp: Caddy Admin API 不可达")
    rows = list_routes()
    if not rows:
        print("（无 devp 路由）")
        return
    for _name, host, dial, port in rows:
        mark = "✅" if reachable(port) else "⛔ 不可达"
        print(f"{host:40s} {dial:22s} {mark}")


def cmd_selftest(a):
    """隔离 Caddy 实例（独立端口/存储）端到端自检，不碰生产 443/2019。"""
    import http.client
    import http.server
    import shutil
    import ssl
    import tempfile

    caddy = shutil.which("caddy") or os.path.expanduser("~/.local/bin/caddy")
    if not os.path.exists(caddy):
        sys.exit(f"devp: 找不到 caddy（{caddy}）")
    tmp = tempfile.mkdtemp(prefix="devp-selftest-")
    # 端口顺序有讲究：Caddy 按 listen 地址字典序给 server 命名（srv0/srv1）。
    # 生产是 :443 < :80 → srv0 为 HTTPS；沙箱也必须让 https_port 排在 http_port 前，
    # 否则 ROUTES_PATH 指向的 srv0 会变成 HTTP 服务，注册的路由不会生效。
    admin_port, https_port, http_port = 20191, 14443, 14480
    cfg = (f"{{\n"
           f"\tadmin localhost:{admin_port}\n"
           f"\tstorage file_system {tmp}/data\n"
           f"\thttp_port {http_port}\n"
           f"\thttps_port {https_port}\n"
           f"}}\n\n"
           f"*.test {{\n"
           f"\ttls {{\n"
           f"\t\ton_demand\n"
           f"\t\tissuer internal\n"
           f"\t}}\n"
           f"\trespond \"fallback\" 404\n"
           f"}}\n\n"
           f"http://*.test {{\n"
           f"\tredir https://{{host}}{{uri}} permanent\n"
           f"}}\n")
    cfg_path = os.path.join(tmp, "Caddyfile")
    with open(cfg_path, "w") as f:
        f.write(cfg)
    base = f"http://127.0.0.1:{admin_port}"

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"hello-from-upstream")

        def log_message(self, *args):
            pass

    upstream = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
    threading.Thread(target=upstream.serve_forever, daemon=True).start()
    uport = upstream.server_address[1]

    caddy_proc = subprocess.Popen([caddy, "run", "--config", cfg_path],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    failures = []

    def check(desc, ok):
        print(("  ✅ " if ok else "  ❌ ") + desc)
        if not ok:
            failures.append(desc)

    cafile = os.path.join(tmp, "data", "pki", "authorities", "local", "root.crt")

    def fetch(host):
        # foo.test 经 dnsmasq 解析到 127.0.0.1/::1，直连沙箱 caddy 的 https_port
        # 信任沙箱自己的 CA：每次请求都做真实主机名校验（通配证书无法蒙混过关）。
        # ctx 在注册前一次性加载：PATCH 会触发整份配置 reload，Caddy 每次都会重装
        # 根证书（内容不变但文件会被重写），每次请求现读 cafile 会撞上重写窗口。
        conn = http.client.HTTPSConnection(host, https_port, context=ctx, timeout=5)
        conn.request("GET", "/")
        r = conn.getresponse()
        body = r.read().decode()
        conn.close()
        return r.status, body

    def fetch_http(host):
        # 直连沙箱 caddy 的 http_port，显式 Host 头不带端口，便于断言 Location
        conn = http.client.HTTPConnection("127.0.0.1", http_port, timeout=5)
        conn.request("GET", "/", headers={"Host": host})
        r = conn.getresponse()
        location = r.getheader("Location")
        conn.close()
        return r.status, location

    try:
        deadline = time.time() + 15
        while time.time() < deadline:
            st, _ = api("GET", "/config/", base=base)
            if st == 200:
                break
            time.sleep(0.3)
        else:
            sys.exit("devp: selftest 沙箱 caddy 启动超时")

        check("沙箱 CA 根证书已生成", os.path.exists(cafile))
        if os.path.exists(cafile):
            # 根证书文件可能仍在写入（Caddy 启动后会安装到各信任库），重试到可加载为止
            deadline = time.time() + 10
            while True:
                try:
                    ctx = ssl.create_default_context(cafile=cafile)
                    break
                except ssl.SSLError:
                    if time.time() >= deadline:
                        raise
                    time.sleep(0.2)
        else:
            ctx = ssl.create_default_context()  # 后续 check 会因主机名校验失败而报错
        check("通配站点可服务（未注册域名兜底 404）", fetch("anything-unregistered.test")[0] == 404)
        check("http://foo.test 301 跳转到 https://foo.test/",
              fetch_http("foo.test") == (301, "https://foo.test/"))
        check("注册前 foo.test 命中兜底 404", fetch("foo.test")[0] == 404)
        check("register(foo) 成功", register("foo", uport, base=base))
        check("注册后 foo.test 命中上游", fetch("foo.test") == (200, "hello-from-upstream"))
        check("route_exists(foo)", route_exists("foo", base=base))
        check("deregister(foo) 成功", deregister("foo", base=base))
        check("注销后 foo.test 回落兜底 404", fetch("foo.test")[0] == 404)
    finally:
        caddy_proc.terminate()
        upstream.shutdown()
        shutil.rmtree(tmp, ignore_errors=True)
    if failures:
        sys.exit(f"devp: selftest 失败 {len(failures)} 项：{'；'.join(failures)}")
    print("selftest 全部通过 ✅")


def main(argv=None):
    raw = list(sys.argv[1:] if argv is None else argv)
    p = argparse.ArgumentParser(prog="devp",
                                description="本地开发动态域名网关（*.test → 动态端口）")
    sub = p.add_subparsers(dest="command", required=True)

    up = sub.add_parser("up", help="分配端口并启动命令，注册 <name>.test")
    up.add_argument("name", help="路由名（单标签 [a-z0-9-]）")
    up.add_argument("--port", type=int, default=None, help="显式端口（默认自动分配）")
    up.add_argument("--ready-timeout", type=int, default=60,
                    help="就绪超时秒数（默认 60）")

    down = sub.add_parser("down", help="注销 <name>.test")
    down.add_argument("name")

    sub.add_parser("ls", help="列出 devp 路由")

    sub.add_parser("selftest", help="隔离 Caddy 实例端到端自检")

    # '--' 之后全部是子进程命令，先按原始 argv 切片再交给 argparse，
    # 否则 name 之后的选项（如 --port）会被当成子进程参数吞掉。
    if "--" in raw:
        i = raw.index("--")
        a = p.parse_args(raw[:i])
        a.cmd = raw[i + 1:]
    else:
        a = p.parse_args(raw)
        if a.command == "up":
            p.error("缺少 '--'：devp up <name> [--port N] [--ready-timeout S] -- CMD...")

    if a.command == "up":
        if not a.cmd:
            p.error("缺少启动命令：-- 之后需要 CMD...")
        cmd_up(a)
    elif a.command == "down":
        cmd_down(a)
    elif a.command == "ls":
        cmd_ls(a)
    elif a.command == "selftest":
        cmd_selftest(a)


if __name__ == "__main__":
    main()
